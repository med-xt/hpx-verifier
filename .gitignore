# The compiled binary, which is built from source rather than committed.
#
# This was previously a bare `verify`, with no leading slash. A bare pattern in
# a gitignore matches a file OR A DIRECTORY of that name at any depth, so it
# silently excluded cmd/verify/ and the repository never contained the program
# its own README tells people to build. Anchor it, so it means the binary at the
# repository root and nothing else.
/verify
bin/
*.exe
.DS_Store

# Python bytecode. Written automatically the first time check_vectors.py
# imports hpx, so it appears without anyone asking for it and `git add python`
# picks it up. Two .pyc files reached a published commit that way.
#
# They matter more here than in most repositories. This one asks a reviewer to
# read the source and check that it does what it claims, so a compiled artifact
# nobody can read, committed beside the source it was built from, is noise in
# exactly the place the repository is making a point about transparency. The
# source is the deliverable.
__pycache__/
*.py[cod]
