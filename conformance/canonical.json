        }
      },
      "expected": "{\"actor\":{\"id\":\"1275551103\",\"scheme\":\"npi\"},\"assertion\":{\"orderCount\":1,\"signedAtPointOfOrder\":true},\"episode\":\"ep_0001\",\"evidence\":[{\"alg\":\"sha256\",\"descriptor\":\"plan of care\",\"digest\":\"sha256:bb\"}],\"key\":{\"alg\":\"ML-DSA-65\",\"id\":\"k-clin-004\",\"version\":1},\"prev\":\"sha256:aa\",\"seq\":2,\"spec\":\"hpx/1\",\"subject\":{\"id\":\"p_01\",\"scheme\":\"mbi-pseudonym\"},\"time\":\"2026-09-11T19:40:00.000Z\",\"type\":\"order.proof\"}",
      "digest": "sha256:cb4b5265f46819cee03d263df61fa1762585d468769f8419058ec229bec0bfd3"
    }
  ]
